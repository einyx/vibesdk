{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.builder.tsbuildinfo",
		"types": ["@cloudflare/workers-types", "./worker-configuration.d.ts", "vite/client", "node"],
		"lib": ["ES2023"]
	},
	"include": [
		"./worker-configuration.d.ts",
		"./shared",
		"./worker",
		"./worker/types",
		"./runtime/src/platform.ts",
		"./runtime/src/env.ts",
		"./runtime/src/session.ts",
		"./runtime/src/context.ts",
		"./runtime/src/storage.ts",
		"./runtime/src/rpc.ts",
		"./runtime/src/types.ts",
		"./runner/protocol.ts",
		"./publisher/protocol.ts",
		"./builder/src",
		"./builder/scripts",
		"./packages/artifacts-viewer/packages/artifacts-viewer/src/index.ts",
		"./packages/artifacts-viewer/packages/artifacts-viewer/src/server",
		"./packages/artifacts-viewer/packages/artifacts-viewer/src/shared/api-path.ts",
		"./packages/artifacts-viewer/packages/artifacts-viewer/src/shared/official-types.ts"
	],
	"exclude": ["**/__tests__/**/*", "**/*.test.ts"]
}
