/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
 {
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibesdk-production",
	"main": "worker/index.ts",
	// Resolve the vendored artifacts-viewer server entrypoints for the Worker
	// bundle. `wrangler deploy` uses esbuild (not Vite), so it does not read
	// vite.config.ts aliases; these mirror them for the two server-only
	// specifiers the Worker imports (the React/client/styles subpaths are
	// frontend-only and resolved by Vite).
	"alias": {
		"artifacts-viewer": "./packages/artifacts-viewer/packages/artifacts-viewer/src/index.ts",
		"artifacts-viewer/server/cache": "./packages/artifacts-viewer/packages/artifacts-viewer/src/server/cache-adapters.ts"
	},
	// Facets (durable-object-facets) require a recent compat date — bumped
	// from 2025-08-10 to enable `ctx.facets.get()` for space-generated
	// apps' env.DB binding.
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	// Preserve dashboard-managed vars on deploy so dashboard-only settings
	// (e.g. ENABLE_ARTIFACTS and ENABLE_READ_REPLICAS) are not deleted by `wrangler deploy`.
	"keep_vars": true,
	// Treat imported `.md` files (e.g. Think agent SKILL.md) as Text modules so
	// `wrangler deploy` can bundle markdown imports. Unlike `.txt`, `.md` has no
	// built-in esbuild loader. The `?raw` glob is required because wrangler's
	// module-collection `onResolve` filter matches the raw import specifier
	// (which ends in `?raw`) before the query string is stripped.
	"rules": [
		{ "type": "Text", "globs": ["**/*.md", "**/*.md?raw"], "fallthrough": true }
	],
    "version_metadata": {
        "binding": "CF_VERSION_METADATA"
    },
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		// "run_worker_first": ["!/src/*", "!/api/docs/*"],
        "run_worker_first": true,
        "binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
        "head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
    "unsafe": {
        "bindings": [
            {
                "name": "API_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2101",
                "simple": { "limit": 10000, "period": 60 }
            },
            {
                "name": "AUTH_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2102",
                "simple": { "limit": 1000, "period": 60 }
            }
        ]
    },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"ai": {
		"binding": "AI",
        "remote": true
	},
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},
    // // // // // // // // // // // // // // // // // // // // // // // // // // // // "dispatch_namespaces": [
 //     {
 //         "binding": "DISPATCHER",
 //         "namespace": "orange-build-default-namespace",
 //         "experimental_remote": true
 //     }
 // ],
	// No-purchase variant: Cloudflare containers need the Workers Paid plan,
	// so the sandbox class ships unbound for now. App previews are off — the
	// builder itself (sign-in, chat, code generation) runs on the free plan.
	"containers": [],
	"d1_databases": [
        {
            "binding": "DB",
            "database_name": "vibesdk-db",
            "database_id": "721cbdfb-8334-4d29-a8c2-d137220e201e",
            "migrations_dir": "migrations",
            "remote": false
        }
    ],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
            {
                "class_name": "UserAppSandboxService",
                "name": "Sandbox"
            },
            {
                "class_name": "DORateLimitStore",
                "name": "DORateLimitStore"
            },
            {
                "class_name": "UserSecretsStore",
                "name": "UserSecretsStore"
            },
            {
                "class_name": "ThinkAgent",
                "name": "THINK_DO"
            },
            {
                "class_name": "SpaceDO",
                "name": "SPACE_DO"
            }
		]
	},
    // No-purchase variant: worker_loaders (Dynamic Workers) need the paid
    // plan. The LOADER binding is unused by the worker code today, so the
    // bundle ships without it.
    // "worker_loaders": [
    //     {
    //         "binding": "LOADER"
    //     }
    // ],
    // No-purchase variant: R2 is not enabled on this account. Template
    // screenshots degrade (they write through TEMPLATES_BUCKET). The
    // template catalog and zips ship as static assets under
    // public/templates/ and are read through ASSETS — see
    // BaseSandboxService.getTemplateFile.
    "r2_buckets": [],
    "kv_namespaces": [
        {
            "binding": "VibecoderStore",
            "id": "bc693c458d9e458f947cadc9f4be6ff8",
            "remote": false
        }
    ],
    // "placement": {
    //   "mode": "smart"
    // },
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent",
				"UserAppSandboxService"
			],
			"tag": "v1"
		},
        {
            "new_sqlite_classes": [
                "DORateLimitStore"
            ],
            "tag": "v2"
        },
        {
            "new_sqlite_classes": [
                "UserSecretsStore"
            ],
            "tag": "v3"
        },
        {
            "new_sqlite_classes": [
                "SpaceDO"
            ],
            "tag": "v5"
        },
        {
            "new_sqlite_classes": [
                "ThinkAgent"
            ],
            "tag": "v6"
        }
	],
	"routes": [
        {
            "pattern": "apps.prysm.sh",
            "custom_domain": true
        }
    ],
	"vars": {
        "TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibesdk-templates",
        "DISPATCH_NAMESPACE": "",
        "CLOUDFLARE_AI_GATEWAY": "vibesdk-gateway",
        // The account's workers.dev subdomain: where a published app lives when
        // the deployment has no Workers-for-Platforms dispatch namespace.
        "CLOUDFLARE_WORKERS_SUBDOMAIN": "alessio-2b5",
        // Previews are hosted by the runner on the k3s cluster (the sandbox
        // stack), not by this worker: the in-process path needs a paid runtime.
        "SANDBOX_SERVICE_TYPE": "runner",
        "SANDBOX_SERVICE_URL": "https://runner.prysm.sh",
        // The runner serves previews under its own host
        // (runner.prysm.sh/p/<instance>), so preview-domain migration must
        // treat *.prysm.sh as already-current and pass those URLs through.
        // Empty: the previews live on the k3s runner (runner.prysm.sh), not
        // on a wildcard route of the origin zone — a wildcard here would
        // shadow the auth origin.
        "CUSTOM_PREVIEW_DOMAIN": "",
        "ARTIFACTS_NAMESPACE": "vibesdk-production",
        "PLATFORM_CAPABILITIES": {
            "features": {
                "app": {
                    "enabled": true
                },
                "presentation": {
                    "enabled": false
                },
                "general": {
                    "enabled": false
                }
            },
            "version": "1.0.0"
        },
        "MAX_SANDBOX_INSTANCES": "10",
        "SANDBOX_INSTANCE_TYPE": "standard-3",
        "DEV_BROWSER_SIDECAR_URL": "http://127.0.0.1:9223",
        "DEV_BROWSER_PREVIEW_ORIGIN": "http://localhost:5173",
        "CUSTOM_DOMAIN": "apps.prysm.sh"
    },
	"workers_dev": false,
    "preview_urls": false,
    // No-purchase variant: the Artifacts *binding* needs the Workers Paid
    // plan. The artifacts feature itself rides the REST API with
    // ARTIFACTS_API_TOKEN (see ArtifactsController), so the worker ships
    // without the binding.
    // "artifacts": [
    //     {
    //         "binding": "ARTIFACTS",
    //         "namespace": "vibesdk-production"
    //     }
    // ]
}